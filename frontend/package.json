{
  "name": "termin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "mobile:sync": "npm run build -- --mode mobile && cap sync",
    "format": "prettier --write src index.html \"*.ts\" tsconfig.json package.json",
    "format:check": "prettier --check src index.html \"*.ts\" tsconfig.json package.json"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/ios": "^7.4.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.0",
    "vite": "^7.2.0",
    "vue-tsc": "^3.1.0"
  }
}
